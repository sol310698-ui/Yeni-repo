<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <!-- HERO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_hero"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="26dp"
            android:paddingBottom="26dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UZAKTAN KONTROL"
                android:textColor="#D9CFFF"
                android:textSize="11sp"
                android:letterSpacing="0.22"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Wear Commands"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                android:fontFamily="sans-serif" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Telefon ↔ Saat · komut &amp; güvenlik"
                android:textColor="#E7DEFF"
                android:textSize="14sp"
                android:alpha="0.9" />
        </LinearLayout>

        <!-- STATUS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/chip_status"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textColor="#3FE0A0"
                android:textSize="13sp"
                android:paddingEnd="10dp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bagli saat araniyor..."
                android:textColor="#C9C4DE"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- KURULUM -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="10dp"
            android:text="KURULUM"
            android:textColor="#B39DFF"
            android:textSize="12sp"
            android:letterSpacing="0.14"
            android:fontFamily="sans-serif-medium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_surface"
            android:padding="14dp">

            <TextView
                android:id="@+id/permissionsButton"
                style="@style/AppTile"
                android:background="@drawable/btn_ghost"
                android:drawableStart="@drawable/ic_security"
                android:text="@string/btn_permissions" />

            <TextView
                android:id="@+id/adminButton"
                style="@style/AppTile"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_ghost"
                android:drawableStart="@drawable/ic_admin"
                android:text="@string/btn_admin" />

            <TextView
                android:id="@+id/batteryButton"
                style="@style/AppTile"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_ghost"
                android:drawableStart="@drawable/ic_battery"
                android:text="@string/btn_battery" />

            <TextView
                android:id="@+id/pinButton"
                style="@style/AppTile"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_danger"
                android:drawableStart="@drawable/ic_pin"
                android:text="@string/btn_pin" />
        </LinearLayout>

        <!-- TEST -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="10dp"
            android:text="TEST"
            android:textColor="#B39DFF"
            android:textSize="12sp"
            android:letterSpacing="0.14"
            android:fontFamily="sans-serif-medium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_surface"
            android:padding="14dp">

            <TextView
                android:id="@+id/pingButton"
                style="@style/AppTile"
                android:background="@drawable/btn_ghost"
                android:drawableStart="@drawable/ic_bolt"
                android:text="@string/btn_send_ping" />

            <TextView
                android:id="@+id/vibrateButton"
                style="@style/AppTile"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_ghost"
                android:drawableStart="@drawable/ic_vibration"
                android:text="@string/btn_send_vibrate" />

            <EditText
                android:id="@+id/commandInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:hint="@string/hint_command"
                android:textColorHint="#6E6890"
                android:textColor="#ECEAF6"
                android:inputType="textCapCharacters"
                android:importantForAutofill="no" />

            <TextView
                android:id="@+id/customButton"
                style="@style/AppTile"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_primary"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:drawableTint="#FFFFFF"
                android:drawableStart="@drawable/ic_send"
                android:text="@string/btn_send_custom" />
        </LinearLayout>

        <!-- LOG -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="10dp"
            android:text="GELEN / GİDEN"
            android:textColor="#B39DFF"
            android:textSize="12sp"
            android:letterSpacing="0.14"
            android:fontFamily="sans-serif-medium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_surface"
            android:padding="16dp">

            <TextView
                android:id="@+id/logText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/log_empty"
                android:textColor="#9A94BC"
                android:fontFamily="monospace"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
